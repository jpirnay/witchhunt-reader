+; ChaCha20 does not, because HAVE_CHACHA is already on for TLS.
+  -DWOLFSSL_AES_COUNTER
+lib_deps =
+  CacheCipher=symlink://lib/CacheCipher
+  wolfssl/Arduino-wolfSSL @ 5.7.2
+
