# The pipeline tests compare their output byte for byte with these files, and write LF. Without this, a
# Windows checkout with core.autocrlf=true turns them into CRLF and every MatchesGolden test fails.
test/epub_pipeline/goldens/*.txt text eol=lf
# Third-party TeX pattern files, kept byte for byte as published (8-bit encodings, their own line ends).
assets/hyphenation-patterns/**/*.tex -text
